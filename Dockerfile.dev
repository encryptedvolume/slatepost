FROM node:22.20-bookworm-slim
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx


RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

RUN pnpm install

# Operator facts for the legal documents. next build prerenders /terms and
# /privacy, and legal.config.ts throws if any of these is unset, so they must
# be visible to the build - a Dockerfile build only receives variables it
# declares as ARG.

ARG NEXT_PUBLIC_LEGAL_ENTITY_NAME
ENV NEXT_PUBLIC_LEGAL_ENTITY_NAME=$NEXT_PUBLIC_LEGAL_ENTITY_NAME
ARG NEXT_PUBLIC_LEGAL_POSTAL_ADDRESS
ENV NEXT_PUBLIC_LEGAL_POSTAL_ADDRESS=$NEXT_PUBLIC_LEGAL_POSTAL_ADDRESS
ARG NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL
ENV NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=$NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL
ARG NEXT_PUBLIC_LEGAL_CONTACT_EMAIL
ENV NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=$NEXT_PUBLIC_LEGAL_CONTACT_EMAIL
ARG NEXT_PUBLIC_LEGAL_SOURCE_REPO_URL
ENV NEXT_PUBLIC_LEGAL_SOURCE_REPO_URL=$NEXT_PUBLIC_LEGAL_SOURCE_REPO_URL
ARG NEXT_PUBLIC_LEGAL_ERASURE_WINDOW
ENV NEXT_PUBLIC_LEGAL_ERASURE_WINDOW=$NEXT_PUBLIC_LEGAL_ERASURE_WINDOW
ARG NEXT_PUBLIC_LEGAL_BACKUP_RETENTION
ENV NEXT_PUBLIC_LEGAL_BACKUP_RETENTION=$NEXT_PUBLIC_LEGAL_BACKUP_RETENTION
ARG NEXT_PUBLIC_LEGAL_LOG_RETENTION
ENV NEXT_PUBLIC_LEGAL_LOG_RETENTION=$NEXT_PUBLIC_LEGAL_LOG_RETENTION
ARG NEXT_PUBLIC_LEGAL_HOSTING_REGION
ENV NEXT_PUBLIC_LEGAL_HOSTING_REGION=$NEXT_PUBLIC_LEGAL_HOSTING_REGION
ARG NEXT_PUBLIC_LEGAL_HOSTING_PROVIDER
ENV NEXT_PUBLIC_LEGAL_HOSTING_PROVIDER=$NEXT_PUBLIC_LEGAL_HOSTING_PROVIDER
ARG NEXT_PUBLIC_LEGAL_OBJECT_STORAGE_PROVIDER
ENV NEXT_PUBLIC_LEGAL_OBJECT_STORAGE_PROVIDER=$NEXT_PUBLIC_LEGAL_OBJECT_STORAGE_PROVIDER
ARG NEXT_PUBLIC_LEGAL_EMAIL_PROVIDER
ENV NEXT_PUBLIC_LEGAL_EMAIL_PROVIDER=$NEXT_PUBLIC_LEGAL_EMAIL_PROVIDER
ARG NEXT_PUBLIC_LEGAL_LIABILITY_CAP
ENV NEXT_PUBLIC_LEGAL_LIABILITY_CAP=$NEXT_PUBLIC_LEGAL_LIABILITY_CAP
ARG NEXT_PUBLIC_LEGAL_GOVERNING_LAW
ENV NEXT_PUBLIC_LEGAL_GOVERNING_LAW=$NEXT_PUBLIC_LEGAL_GOVERNING_LAW
ARG NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL

RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

RUN chmod +x /app/var/docker/entrypoint.sh

CMD ["sh", "/app/var/docker/entrypoint.sh"]
